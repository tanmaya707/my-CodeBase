const [showMicPopup, setShowMicPopup] = useState(false);
const [micPermission, setMicPermission] = useState<PermissionState | null>(null);


const checkMicPermission = async () => {
    try {
        const permission = await navigator.permissions.query({
            name: "microphone" as PermissionName,
        });

        setMicPermission(permission.state);
        return permission.state;
    } catch (err) {
        console.error("Permission check failed", err);
        return null;
    }
};

const handleAllowMic = async () => {
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });

        // stop immediately → just trigger permission
        stream.getTracks().forEach(track => track.stop());

        setShowMicPopup(false);

        // ✅ call your ORIGINAL function
        startRecording();

    } catch (error) {
        toast.error("Microphone access denied. Enable it from browser settings.");
    }
};


onClick={async () => {
    await checkMicPermission();
    setShowMicPopup(true);
}}





{showMicPopup && (
    <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div className="bg-white rounded-2xl shadow-xl p-6 w-[90%] max-w-md text-center">

            <h2 className="text-xl font-semibold mb-3">
                🎤 Microphone Access Required
            </h2>

            <p className="text-gray-600 mb-5">
                We need access to your microphone to start recording.
            </p>

            {micPermission === "denied" && (
                <div className="mb-4 text-red-500 text-sm">
                    Microphone is blocked. Enable it from browser settings (🔒 icon).
                </div>
            )}

            <div className="flex justify-center gap-3">
                <button
                    onClick={() => setShowMicPopup(false)}
                    className="px-4 py-2 bg-gray-200 rounded-lg"
                >
                    Cancel
                </button>

                <button
                    onClick={handleAllowMic}
                    className="px-4 py-2 bg-blue-600 text-white rounded-lg"
                >
                    Allow Microphone
                </button>
            </div>
        </div>
    </div>
)}




